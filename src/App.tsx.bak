const fieldClassName =
  "w-full rounded-2xl border border-sky-blue/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.98)_0%,rgba(240,249,255,0.98)_100%)] px-4 py-3.5 text-base font-semibold text-slate-800 shadow-[0_10px_25px_-18px_rgba(11,45,109,0.35),inset_0_1px_0_rgba(255,255,255,0.65)] transition focus:border-sky-blue focus:outline-none focus:ring-4 focus:ring-sky-blue/10";

function LeaderPortrait({
  profile,
  className,
  imageClassName,
}: {
  profile: LeaderProfile;
  className: string;
  imageClassName: string;
}) {
  const [failed, setFailed] = useState(false);

  return (
    <div className={className}>
      {!failed ? (
        <img
          src={profile.image}
          alt={profile.name}
          className={imageClassName}
          onError={() => setFailed(true)}
        />
      ) : (
        <div className="portrait-fallback flex h-full w-full items-center justify-center">
          <div className="text-center text-white">
            <div className="text-2xl font-black tracking-[0.35em]">
              {profile.fallback}
            </div>
            <div className="mt-2 text-[10px] font-bold uppercase tracking-[0.3em] text-white/75">
              {profile.role}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function PartyBadge() {
  const [failed, setFailed] = useState(false);

  return (
    <div className="flex h-20 w-20 items-center justify-center rounded-[1.75rem] border border-white/25 bg-white/14 p-3 shadow-2xl backdrop-blur-md sm:h-24 sm:w-24 md:h-28 md:w-28">
      {!failed ? (
        <img
          src={LEADERS.emblem}
          alt="YSRCP Emblem"
          className="h-full w-full object-contain"
          onError={() => setFailed(true)}
        />
      ) : (
        <div className="party-badge-fallback flex h-full w-full items-center justify-center rounded-[1.2rem] text-center">
          <span className="text-xs font-black uppercase tracking-[0.32em] text-white sm:text-sm">
            YSRCP
          </span>
        </div>
      )}
    </div>
  );
}

