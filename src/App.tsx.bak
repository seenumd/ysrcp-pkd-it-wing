type View = "home" | "reports";

type RegistrationStatus = "idle" | "loading" | "success" | "exists" | "error";

type ReportRow = {
  name?: string;
  phonenumber?: string;
  gender?: string;
  occupation?: string;
  mandal?: string;
  panchayat?: string;
  location?: string;
};

