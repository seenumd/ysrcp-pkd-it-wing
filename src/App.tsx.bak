export default function App() {
  const [agreed, setAgreed] = useState(false);
  const [view, setView] = useState<View>("home");
  const [showSecretModal, setShowSecretModal] = useState(false);
  const [enteredKey, setEnteredKey] = useState("");
  const [error, setError] = useState("");
  const [registrationStatus, setRegistrationStatus] =
    useState<RegistrationStatus>("idle");
  const [formData, setFormData] = useState({
    name: "",
    phone: "",
    gender: "",
    occupation: "",
    mandal: "",
    panchayat: "",
    location: "",
  });
  const [reports, setReports] = useState<ReportRow[]>([]);
  const [reportsLoading, setReportsLoading] = useState(false);
  const [reportFilters, setReportFilters] = useState({
    mandal: "",
    panchayat: "",
  });

  const fetchReports = async () => {
    if (!supabase) {
      setReports([]);
      setError("Reports are unavailable until Supabase credentials are configured.");
      return;
    }

    setReportsLoading(true);
    try {
      let query = supabase.from("ysrcppenugondaitwinglist").select("*");

      if (reportFilters.mandal) {
        query = query.eq("mandal", reportFilters.mandal);
      }

      if (reportFilters.panchayat) {
        query = query.ilike("panchayat", `%${reportFilters.panchayat}%`);
      }

      const { data, error: fetchError } = await query;
      if (fetchError) {
        throw fetchError;
      }
      setReports((data as ReportRow[]) || []);
    } catch (err) {
      console.error("Fetch error:", err);
    } finally {
      setReportsLoading(false);
    }
  };

  useEffect(() => {
    if (view === "reports") {
      fetchReports();
    }
  }, [view, reportFilters.mandal]);

  const handleDownloadCSV = () => {
    if (reports.length === 0) {
      return;
    }

    const headers = [
      "name",
      "phonenumber",
      "gender",
      "occupation",
      "mandal",
      "panchayat",
      "location",
    ] as const;
    const displayHeaders = [
      "Name",
      "Phone",
      "Gender",
      "Occupation",
      "Mandal",
      "Panchayat",
      "Location",
    ];

    const csvContent = [
      displayHeaders.join(","),
      ...reports.map((row) =>
        headers.map((header) => `"${row[header] || ""}"`).join(",")
      ),
    ].join("\n");

    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    const url = URL.createObjectURL(blob);
    link.setAttribute("href", url);
    link.setAttribute(
      "download",
      `YSRCP_IT_WING_REPORT_${new Date().toISOString().split("T")[0]}.csv`,
    );
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const handleInputChange = (
    e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>,
  ) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  };

  const resetForm = () => {
    setRegistrationStatus("idle");
    setFormData({
      name: "",
      phone: "",
      gender: "",
      occupation: "",
      mandal: "",
      panchayat: "",
      location: "",
    });
    setAgreed(false);
    setError("");
  };

  const handleRegistration = async () => {
    if (!agreed) {
      setError("Please agree to the terms.");
      return;
    }

    if (!formData.name || !formData.phone || !formData.mandal) {
      setError("Please fill in all required fields.");
      return;
    }

    setRegistrationStatus("loading");
    setError("");

    try {
      if (!supabase) {
        throw new Error(
          "Registration is unavailable until Supabase credentials are configured.",
        );
      }

      const { data: existingUser, error: checkError } = await supabase
        .from("ysrcppenugondaitwinglist")
        .select("phonenumber")
        .eq("phonenumber", formData.phone)
        .single();

      if (existingUser) {
        setRegistrationStatus("exists");
        return;
      }

      if (checkError && checkError.code !== "PGRST116") {
        throw checkError;
      }

      const { error: insertError } = await supabase
        .from("ysrcppenugondaitwinglist")
        .insert([
          {
            name: formData.name,
            phonenumber: formData.phone,
            gender: formData.gender,
            occupation: formData.occupation,
            mandal: formData.mandal,
            panchayat: formData.panchayat,
            location: formData.location,
          },
        ]);

      if (insertError) {
        throw insertError;
      }

      setRegistrationStatus("success");
    } catch (err: any) {
      console.error("Registration error:", err);
      setRegistrationStatus("error");
      setError(err.message || "An error occurred during registration.");
    }
  };

  const handleReportsClick = (e: React.MouseEvent) => {
    e.preventDefault();
    if (view === "reports") {
      setView("home");
      return;
    }
    setShowSecretModal(true);
  };

  useEffect(() => {
    if (view !== "reports") {
      return;
    }

    if (!supabase) {
      setError("Reports are unavailable until Supabase credentials are configured.");
    }
  }, [view]);

  const verifyKey = () => {
    const secret = import.meta.env.VITE_REPORTS_SECRET || "PkdITWING2029";
    if (enteredKey === secret) {
      setView("reports");
      setShowSecretModal(false);
      setEnteredKey("");
      setError("");
      return;
    }
    setError("Invalid Secret Key. Please try again.");
  };

  return (
    <div className="min-h-screen bg-slate-50 font-body text-slate-900">
      <header className="sticky top-0 z-50 border-b border-white/10 bg-primary/95 px-4 py-3 shadow-lg backdrop-blur-md sm:px-6 md:px-10">
        <div className="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3">
          <motion.button
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            onClick={() => setView("home")}
            className="text-left font-headline text-sm font-black uppercase tracking-[0.25em] text-white sm:text-lg"
          >
            YSRCP IT WING
          </motion.button>

          <nav className="flex items-center gap-2 sm:gap-3">
            <div className="hidden items-center gap-6 md:flex">
              {["HOME", "ABOUT"].map((item) => (
                <a
                  key={item}
                  href="#"
                  onClick={(e) => {
                    e.preventDefault();
                    if (item === "HOME") {
                      setView("home");
                    }
                  }}
                  className={`font-headline text-sm font-bold tracking-[0.22em] transition-colors ${
                    item === "HOME" && view === "home"
                      ? "border-b-2 border-white pb-1 text-white"
                      : "text-white/70 hover:text-white"
                  }`}
                >
                  {item}
                </a>
              ))}
            </div>
            <button
              onClick={handleReportsClick}
              className={`rounded-full px-4 py-2 text-[10px] font-black uppercase tracking-[0.24em] shadow-md transition-all sm:px-5 sm:text-xs ${
                view === "reports"
                  ? "bg-gold text-primary"
                  : "bg-secondary text-white hover:bg-deep-green"
              }`}
            >
              {view === "reports" ? "Back To Home" : "Reports"}
            </button>
          </nav>
        </div>
      </header>

      <main>
        <AnimatePresence mode="wait">
          {view === "home" ? (
            <motion.div
              key="home"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
            >
              <HeroSection
                title="YSRCP IT Wing"
                subtitle="One Flag - YSRCP, One Aim - 2029."
              />

              <section className="relative overflow-hidden bg-[linear-gradient(180deg,#f8fbff_0%,#ffffff_35%,#f7faf8_100%)] px-4 py-14 sm:px-6 md:px-10 md:py-20">
                <div className="absolute inset-x-0 top-0 h-32 bg-[radial-gradient(circle_at_top,rgba(0,174,239,0.12),transparent_60%)]" />
                <div className="mx-auto max-w-5xl">
                  <div className="mx-auto mb-12 max-w-3xl text-center md:mb-16">
                    <motion.span
                      initial={{ opacity: 0, y: 10 }}
                      whileInView={{ opacity: 1, y: 0 }}
                      className="text-[10px] font-black uppercase tracking-[0.38em] text-secondary"
                    >
                      Registration Desk
                    </motion.span>
                    <motion.h2
                      initial={{ opacity: 0, y: 10 }}
                      whileInView={{ opacity: 1, y: 0 }}
                      transition={{ delay: 0.1 }}
                      className="mt-4 text-3xl font-black uppercase tracking-tight text-primary sm:text-4xl md:text-6xl"
                    >
                      Join The Revolution
                    </motion.h2>
                    <div className="mx-auto mt-5 h-1.5 w-24 rounded-full bg-secondary" />
                    <motion.p
                      initial={{ opacity: 0, y: 10 }}
                      whileInView={{ opacity: 1, y: 0 }}
                      transition={{ delay: 0.2 }}
                      className="mx-auto mt-6 max-w-2xl text-base font-medium leading-7 text-slate-600 md:text-lg"
                    >
                      Be part of the Penugonda IT Wing. The form now uses larger touch targets, calmer spacing, and a more premium party-led visual language on mobile.
                    </motion.p>
                  </div>

                  <motion.div
                    initial={{ opacity: 0, scale: 0.98 }}
                    whileInView={{ opacity: 1, scale: 1 }}
                    viewport={{ once: true }}
                    className="glass-card rounded-[2rem] p-5 shadow-[0_30px_80px_-40px_rgba(0,32,91,0.35)] sm:p-7 md:rounded-[2.75rem] md:p-12"
                  >
                    {registrationStatus === "success" ||
                    registrationStatus === "exists" ? (
                      <div className="space-y-8 py-8 text-center md:py-10">
                        <div
                          className={`mx-auto flex h-24 w-24 items-center justify-center rounded-full ${
                            registrationStatus === "exists"
                              ? "bg-amber-100 text-amber-500"
                              : "bg-secondary/10 text-secondary"
                          }`}
                        >
                          {registrationStatus === "exists" ? (
                            <AlertCircle className="h-12 w-12" />
                          ) : (
                            <CheckCircle2 className="h-12 w-12" />
                          )}
                        </div>
                        <div className="space-y-3">
                          <h3 className="text-2xl font-black uppercase text-primary md:text-3xl">
                            {registrationStatus === "exists"
                              ? "Already Registered"
                              : "Registration Complete"}
                          </h3>
                          <p className="mx-auto max-w-xl text-base font-medium text-slate-600 md:text-lg">
                              {registrationStatus === "exists"
                                ? "You have already registered your information. Thank you for your support."
                                : "Thank you for registering with YSRCP IT Wing. We'll be in touch soon."}
                            </p>
                        </div>
                        <button
                          onClick={resetForm}
                          className="rounded-2xl bg-primary px-8 py-4 text-sm font-bold uppercase tracking-[0.22em] text-white transition hover:brightness-110"
                        >
                          Register Another
                        </button>
                      </div>
                    ) : (
                      <form
                        className="space-y-8 md:space-y-10"
                        onSubmit={(e) => {
                          e.preventDefault();
                          handleRegistration();
                        }}
                      >
                        <div className="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
                          <div className="space-y-2">
                            <label className="text-[11px] font-black uppercase tracking-[0.22em] text-primary">
                              Name / పేరు
                            </label>
                            <input
                              type="text"
                              name="name"
                              value={formData.name}
                              onChange={handleInputChange}
                              placeholder="Enter name"
                              className={fieldClassName}
                              required
                            />
                          </div>

                          <div className="space-y-2">
                            <label className="text-[11px] font-black uppercase tracking-[0.22em] text-primary">
                              Phone Number / ఫోన్ నంబర్
                            </label>
                            <input
                              type="tel"
                              name="phone"
                              value={formData.phone}
                              onChange={handleInputChange}
                              placeholder="Enter 10-digit number"
                              className={fieldClassName}
                              required
                            />
                          </div>

                          <div className="relative space-y-2">
                            <label className="text-[11px] font-black uppercase tracking-[0.22em] text-primary">
                              Gender / లింగం
                            </label>
                            <select
                              name="gender"
                              value={formData.gender}
                              onChange={handleInputChange}
                              className={`${fieldClassName} appearance-none pr-11`}
                            >
                              <option value="">Select Gender</option>
                              <option value="Male">Male</option>
                              <option value="Female">Female</option>
                              <option value="Other">Other</option>
                            </select>
                            <ChevronDown className="pointer-events-none absolute right-4 top-[3.1rem] h-5 w-5 text-slate-400" />
                          </div>

                          <div className="relative space-y-2">
                            <label className="text-[11px] font-black uppercase tracking-[0.22em] text-primary">
                              Occupation / వృత్తి
                            </label>
                            <select
                              name="occupation"
                              value={formData.occupation}
                              onChange={handleInputChange}
                              className={`${fieldClassName} appearance-none pr-11`}
                            >
                              <option value="">Select Option</option>
                              <option value="Software Professional">
                                Software Professional
                              </option>
                              <option value="Student">Student</option>
                              <option value="Business">Business</option>
                              <option value="Other">Other</option>
                            </select>
                            <ChevronDown className="pointer-events-none absolute right-4 top-[3.1rem] h-5 w-5 text-slate-400" />
                          </div>

                          <div className="relative space-y-2">
                            <label className="text-[11px] font-black uppercase tracking-[0.22em] text-primary">
                              Mandal / మండలం
                            </label>
                            <select
                              name="mandal"
                              value={formData.mandal}
                              onChange={handleInputChange}
                              className={`${fieldClassName} appearance-none pr-11`}
                              required
                            >
                              <option value="">Select Mandal</option>
                              <option value="Penugonda">Penugonda</option>
                              <option value="Gorantla">Gorantla</option>
                              <option value="Somandepalli">Somandepalli</option>
                              <option value="Parigi">Parigi</option>
                              <option value="Roddam">Roddam</option>
                            </select>
                            <ChevronDown className="pointer-events-none absolute right-4 top-[3.1rem] h-5 w-5 text-slate-400" />
                          </div>

                          <div className="space-y-2">
                            <label className="text-[11px] font-black uppercase tracking-[0.22em] text-primary">
                              Panchayat / పంచాయితీ
                            </label>
                            <input
                              type="text"
                              name="panchayat"
                              value={formData.panchayat}
                              onChange={handleInputChange}
                              placeholder="Enter Panchayat name"
                              className={fieldClassName}
                            />
                          </div>

                          <div className="space-y-2 md:col-span-2">
                            <label className="text-[11px] font-black uppercase tracking-[0.22em] text-primary">
                              Present Location / ప్రస్తుతం ఉన్న ప్రదేశం
                            </label>
                            <input
                              type="text"
                              name="location"
                              value={formData.location}
                              onChange={handleInputChange}
                              placeholder="Your working location"
                              className={fieldClassName}
                            />
                          </div>
                        </div>

                        <div className="space-y-5 rounded-[1.75rem] border border-secondary/10 bg-primary/[0.03] p-5 sm:p-6">
                          <div className="rounded-[1.5rem] border-l-4 border-secondary bg-white/80 p-5">
                            <p className="text-sm font-medium italic leading-7 text-slate-600 md:text-base">
                              "I hereby declare that I am a voluntary member of the YSRCP IT Wing and agree to the digital code of conduct."
                            </p>
                          </div>

                          <label className="flex cursor-pointer items-start gap-4 rounded-2xl bg-white/80 p-4">
                            <div
                              onClick={() => setAgreed(!agreed)}
                              className={`mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border-2 transition-all ${
                                agreed
                                  ? "border-secondary bg-secondary"
                                  : "border-slate-300 shadow-inner"
                              }`}
                            >
                              {agreed && <Check className="h-4 w-4 text-white" />}
                            </div>
                            <span className="text-sm font-bold leading-6 text-slate-600">
                              I agree to the terms and conditions / నేను పై నిబంధనలను అంగీకరిస్తున్నాను
                            </span>
                          </label>
                        </div>

                        {error && (
                          <motion.div
                            initial={{ opacity: 0, height: 0 }}
                            animate={{ opacity: 1, height: "auto" }}
                            className="rounded-2xl bg-red-50 p-4 text-center text-sm font-bold uppercase tracking-[0.18em] text-red-500"
                          >
                            {error}
                          </motion.div>
                        )}

                        <motion.button
                          whileHover={{ scale: 1.01 }}
                          whileTap={{ scale: 0.99 }}
                          type="submit"
                          disabled={registrationStatus === "loading"}
                          className={`glossy-button flex w-full items-center justify-center gap-3 rounded-2xl px-6 py-5 text-center font-headline text-sm font-black uppercase tracking-[0.28em] text-white shadow-2xl transition-all sm:text-base ${
                            registrationStatus === "loading"
                              ? "cursor-not-allowed opacity-70"
                              : ""
                          }`}
                        >
                          {registrationStatus === "loading" && (
                            <Loader2 className="h-5 w-5 animate-spin" />
                          )}
                          {registrationStatus === "loading"
                            ? "Processing..."
                            : "Complete Registration"}
                        </motion.button>
                      </form>
                    )}
                  </motion.div>
                </div>
              </section>
            </motion.div>
          ) : (
            <motion.div
              key="reports"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
            >
              <HeroSection
                title="YSRCP IT Wing"
                subtitle="You can filter and download detailed reports for Mandal and Panchayat levels."
                eyebrow="Welcome"
              />

              <section className="bg-white px-4 py-14 sm:px-6 md:px-10 md:py-16">
                <div className="mx-auto max-w-7xl">
                  <div className="mx-auto mb-12 max-w-3xl text-center md:mb-16">
                    <motion.span
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      className="text-[11px] font-black uppercase tracking-[0.3em] text-secondary"
                    >
                      Analytics Portal
                    </motion.span>
                    <motion.h2
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ delay: 0.1 }}
                      className="mt-4 text-3xl font-black uppercase tracking-tight text-primary sm:text-4xl md:text-6xl"
                    >
                      Constituency Reports
                    </motion.h2>
                    <div className="mx-auto mt-5 h-1.5 w-24 rounded-full bg-secondary" />
                    <motion.p
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ delay: 0.2 }}
                      className="mx-auto mt-6 max-w-2xl text-base font-medium leading-7 text-slate-500 md:text-lg"
                    >
                      Filter and download detailed reports for Mandal and Panchayat levels.
                    </motion.p>
                  </div>

                  <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    className="overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-[0_24px_70px_-35px_rgba(0,0,0,0.18)] md:rounded-[2.5rem]"
                  >
                    <div className="border-b border-slate-100 bg-[linear-gradient(180deg,#ffffff_0%,#f8fbff_100%)] p-5 sm:p-6 md:p-10">
                      <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-end">
                        <div className="space-y-2">
                          <label className="text-[11px] font-black uppercase tracking-[0.2em] text-primary">
                            Mandal Name
                          </label>
                          <div className="relative">
                            <select
                              value={reportFilters.mandal}
                              onChange={(e) =>
                                setReportFilters((prev) => ({
                                  ...prev,
                                  mandal: e.target.value,
                                }))
                              }
                              className={`${fieldClassName} appearance-none pr-11`}
                            >
                              <option value="">All Mandals</option>
                              <option value="Penugonda">Penugonda</option>
                              <option value="Gorantla">Gorantla</option>
                              <option value="Somandepalli">Somandepalli</option>
                              <option value="Parigi">Parigi</option>
                              <option value="Roddam">Roddam</option>
                            </select>
                            <ChevronDown className="pointer-events-none absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" />
                          </div>
                        </div>

                        <div className="space-y-2">
                          <label className="text-[11px] font-black uppercase tracking-[0.2em] text-primary">
                            Panchayat Name
                          </label>
                          <div className="relative">
                            <input
                              type="text"
                              placeholder="Search Panchayat"
                              value={reportFilters.panchayat}
                              onChange={(e) =>
                                setReportFilters((prev) => ({
                                  ...prev,
                                  panchayat: e.target.value,
                                }))
                              }
                              onKeyDown={(e) =>
                                e.key === "Enter" && fetchReports()
                              }
                              className={`${fieldClassName} pl-11`}
                            />
                            <Search className="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-300" />
                          </div>
                        </div>

                        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:flex">
                          <button
                            onClick={fetchReports}
                            className="glossy-button flex items-center justify-center gap-3 rounded-2xl px-6 py-4 text-xs font-black uppercase tracking-[0.22em] text-white shadow-xl transition hover:scale-[1.01]"
                          >
                            <Search className="h-5 w-5" />
                            Search
                          </button>
                          <button
                            onClick={handleDownloadCSV}
                            disabled={reports.length === 0}
                            className={`flex items-center justify-center gap-3 rounded-2xl bg-secondary px-6 py-4 text-xs font-black uppercase tracking-[0.22em] text-white shadow-xl transition ${
                              reports.length === 0
                                ? "cursor-not-allowed opacity-50"
                                : "hover:scale-[1.01]"
                            }`}
                          >
                            <Download className="h-5 w-5" />
                            Download
                          </button>
                        </div>
                      </div>
                    </div>

                    <div className="border-b border-sky-blue/10 bg-[linear-gradient(180deg,rgba(240,249,255,0.75)_0%,rgba(255,255,255,0.98)_100%)] px-5 py-4 sm:px-6 md:px-10">
                      <div className="grid gap-3 sm:grid-cols-3">
                        <div className="rounded-2xl border border-sky-blue/10 bg-white/90 p-4 shadow-[0_12px_30px_-25px_rgba(11,45,109,0.4)]">
                          <p className="text-[10px] font-black uppercase tracking-[0.24em] text-slate-400">
                            Total Results
                          </p>
                          <p className="mt-2 text-2xl font-black text-primary">
                            {reports.length}
                          </p>
                        </div>
                        <div className="rounded-2xl border border-sky-blue/10 bg-white/90 p-4 shadow-[0_12px_30px_-25px_rgba(11,45,109,0.4)]">
                          <p className="text-[10px] font-black uppercase tracking-[0.24em] text-slate-400">
                            Active Mandal
                          </p>
                          <p className="mt-2 text-lg font-black text-primary">
                            {reportFilters.mandal || "All Mandals"}
                          </p>
                        </div>
                        <div className="rounded-2xl border border-sky-blue/10 bg-white/90 p-4 shadow-[0_12px_30px_-25px_rgba(11,45,109,0.4)]">
                          <p className="text-[10px] font-black uppercase tracking-[0.24em] text-slate-400">
                            Panchayat Search
                          </p>
                          <p className="mt-2 text-lg font-black text-primary">
                            {reportFilters.panchayat || "Not Applied"}
                          </p>
                        </div>
                      </div>
                    </div>

                    <div className="min-h-[360px]">
                      {reportsLoading ? (
                        <div className="flex flex-col items-center justify-center space-y-4 py-24">
                          <Loader2 className="h-12 w-12 animate-spin text-secondary" />
                          <p className="text-xs font-bold uppercase tracking-[0.24em] text-slate-400">
                            Decrypting Records...
                          </p>
                        </div>
                      ) : reports.length > 0 ? (
                        <>
                          <div className="md:hidden">
                            <div className="grid gap-4 p-4 sm:p-5">
                              {reports.map((row, i) => (
                                <article
                                  key={i}
                                  className="rounded-[1.6rem] border border-slate-100 bg-[linear-gradient(180deg,#ffffff_0%,#f8fbff_100%)] p-5 shadow-[0_12px_35px_-25px_rgba(0,0,0,0.2)]"
                                >
                                  <div className="flex items-start justify-between gap-3">
                                    <div>
                                      <p className="mt-1 font-mono text-sm font-bold text-slate-500">
                                        {row.phonenumber ?? '-'}
                                      </p>
                                      <p className="text-base mt-2">
                                        {row.name ?? '-'}
                                      </p>
                                    </div>
                                  </div>
                                </article>
                              ))}
                            </div>
                          </div>
                        </>
                      ) : (
                        <p>No reports available.</p>
                      )}
                    </div>
                  </motion.div>
                </div>
              </section>
            </motion.div>
          )}
        </AnimatePresence>
      </main>
    </div>
  );
}



